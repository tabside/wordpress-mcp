# Pflicht
# Öffentliche URL des Gateways (eigene Subdomain, ohne Pfad empfohlen)
PUBLIC_BASE_URL=https://wordpress-mcp.example.com
# Login-Benutzer des Gateways: name=<hash>, mehrere mit Komma getrennt.
# Hash erzeugen: docker run --rm -i ghcr.io/tabside/wordpress-mcp wordpressmcp hash-password
GATEWAY_USERS=
# WordPress-Seiten als JSON-Liste (eine Zeile, darf anfangs leer sein). user (Standard claude-mcp), label und endpoint sind optional.
# WP_SITES=[{"id":"kunde","url":"https://www.example.com","app_password":"xxxx xxxx xxxx xxxx xxxx xxxx","label":"Kunde AG"}]
WP_SITES=

# Optional
SERVICE_NAME=WordPress MCP
MCP_BIND_ADDR=127.0.0.1
MCP_HOST_PORT=8440
TRUSTED_PROXIES=*
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
TOOL_CALLS_PER_MINUTE=120
WP_TIMEOUT=60
MAX_FILE_MB=20
WORDPRESS_MCP_TAG=latest
